# TheCrossWild API — environment variables
#
# Local dev: copy to .env and fill in.
# Production: set these in Coolify → app → Environment Variables.
#   • UNCHECK "Build Variable" on every one of them (they are runtime values).
#   • Tick "Is Secret" on MONGODB_URI, JWT_SECRET, CLOUDINARY_API_SECRET, ADMIN_PASSWORD.
#   • If Coolify shows separate Production and Preview columns, fill BOTH.

# ── Server ────────────────────────────────────────────────────────────────────
# Must match the Coolify "Ports Exposes" value and the health-check port.
PORT=5000
NODE_ENV=production

# ── Database ──────────────────────────────────────────────────────────────────
# Coolify-managed MongoDB: copy the "Mongo URL (internal)" from the database
# resource, then append the database name and authSource. Shape:
#   mongodb://<user>:<pass>@<resource-uuid>:27017/thecrosswild?authSource=admin&directConnection=true
# The hostname is the Coolify resource UUID, reachable over the `coolify` Docker
# network — never the public IP.
MONGODB_URI=

# ── Cloudinary (image hosting; uploads stream through memory, no disk volume) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Auth ──────────────────────────────────────────────────────────────────────
# The server refuses to boot without this. Generate a fresh one for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Seed/bootstrap admin account used by the scripts in scripts/ and seeds/.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Optional. thecrosswild.com, www.thecrosswild.com and the Vercel admin origin
# are always allowed. Add extra origins here, comma-separated, e.g. a new admin
# domain. The API's own domain does not need to be listed.
CORS_ORIGIN=

# ── Image storage ─────────────────────────────────────────────────────────────
# Leave unset (or anything other than "r2") and new uploads go to Cloudinary,
# exactly as before. Set to r2 to store new uploads in Cloudflare R2 as WebP.
# Existing images already moved by scripts/migrate-cloudinary-to-r2.js work
# either way — the database holds absolute URLs.
STORAGE_DRIVER=

R2_BUCKET=crosswild-all-assets
R2_KEY_PREFIX=CrossWild
R2_ACCOUNT_ID=17daa337a58fac816cc644fa2b07b169
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE=https://pub-e632e16b74374ce8bb6fc4f36b6e36a7.r2.dev
